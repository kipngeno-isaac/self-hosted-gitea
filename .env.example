# Copy this file to .env and fill in your values
# .env is git-ignored — never commit it

# Domain or bare IP pointing to this server
DOMAIN=gitea.example.com

# Protocol: use "https" for domain + TLS, "http" for bare-IP deployments
PROTOCOL=https

# Postgres credentials
POSTGRES_USER=gitea
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=gitea

# Gitea run user IDs (match host user or leave as 1000)
USER_UID=1000
USER_GID=1000

# Act Runner registration token (get from Gitea → Site Admin → Runners)
RUNNER_TOKEN=your_runner_registration_token

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=admin@example.com

# Grafana admin credentials (accessible at /grafana via Nginx)
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password
