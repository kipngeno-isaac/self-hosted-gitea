{
  "title": "Gitea Overview",
  "uid": "gitea-overview",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "tags": ["gitea"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Users",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "gitea_users{state=\"active\"}", "legendFormat": "Users" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Repositories",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "gitea_repositories", "legendFormat": "Repos" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Organizations",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "gitea_organizations", "legendFormat": "Orgs" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gitea Memory",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"gitea\"} / 1024 / 1024", "legendFormat": "MB" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "mbytes" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Host CPU Cores",
      "gridPos": { "x": 4, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "count(node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "Cores" }],
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Host Free Memory",
      "gridPos": { "x": 8, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes / 1024 / 1024 / 1024", "legendFormat": "GB" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "decgbytes", "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "yellow" }, { "value": 4, "color": "green" }] } } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gitea CPU Usage",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"gitea\"}[5m]) * 100", "legendFormat": "CPU %" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host CPU Usage %",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gitea Process Memory",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"gitea\"}", "legendFormat": "RSS" },
        { "expr": "process_virtual_memory_bytes{job=\"gitea\"}", "legendFormat": "Virtual" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk Space Available",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "legendFormat": "/ available" },
        { "expr": "node_filesystem_size_bytes{mountpoint=\"/\"}", "legendFormat": "/ total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
